---
import { PawPrint } from 'lucide-astro';
---

<header class="absolute top-0 left-0 right-0 z-20 bg-white">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8">

    <a href="/" class="flex items-center gap-2">
      <img
        src="/images/lostpaws-paw.png"
        alt=""
        class="h-9 w-9 object-contain"
      />

      <span class="text-2xl font-bold tracking-tight text-[#17372a]">
        LostPaws
      </span>
    </a> 

    <nav class="hidden items-center gap-8 md:flex">
      <a
        href="/"
        class="border-b-2 border-[#315c3e] py-7 text-sm font-medium text-[#315c3e]"
      >
        Home
      </a>

      <a href="/lost" class="text-sm font-medium text-gray-700 hover:text-[#315c3e]">
        Lost Pets
      </a>

      <a href="/found" class="text-sm font-medium text-gray-700 hover:text-[#315c3e]">
        Found Pets
      </a>

      <a href="/how-it-works" class="text-sm font-medium text-gray-700 hover:text-[#315c3e]">
        How It Works
      </a>

      <a href="/faq" class="text-sm font-medium text-gray-700 hover:text-[#315c3e]">
        FAQ
      </a>
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a
        href="/report"
        class="rounded-lg bg-[#315c3e] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#264b32]"
      >
        + Report a Pet
      </a>

      <a
        href="/login"
        class="rounded-lg border border-gray-300 px-5 py-3 text-sm font-medium text-gray-700 transition hover:border-[#315c3e] hover:text-[#315c3e]"
      >
        Log In
      </a>
    </div>

  </div>
</header>