---
import { PawPrint, Heart, MapPin, UsersRound, ClipboardList } from 'lucide-astro';
---

<section class="relative min-h-[620px] overflow-hidden pt-20">

  <!-- Background -->
  <div class="absolute inset-0">
    <img
      src="/images/hero-lostpaws.png"
      alt="Dog waiting to find its family"
      class="h-full w-full object-cover object-[70%] lg:object-center"
    />

    <div
      class="absolute inset-0 bg-gradient-to-r from-[#f1f7ec]/95 via-[#f1f7ec]/30 to-[#f1f7ec]/5 lg:from-[#f1f7ec] lg:via-[#f1f7ec]/10 lg:to-transparent"
    ></div>
  </div>

  <!-- Content -->
  <div class="relative mx-auto flex min-h-[540px] max-w-7xl items-center px-6 lg:px-8">

    <div class="w-full max-w-xl py-16 lg:py-20">

      <!-- Title -->
      <h1 class="max-w-full text-4xl font-bold leading-tight tracking-tight text-[#17372a] sm:text-5xl lg:text-6xl">
        Help lost pets
        <br />
        find their way home

        <Heart
          size={42}
          strokeWidth={2}
          class="ml-1 inline-block -translate-y-1 fill-[#8bb85a] text-[#8bb85a] sm:ml-2"
        />
      </h1>

      <!-- Description -->
      <p class="mt-6 max-w-lg text-base leading-7 text-gray-600 sm:text-lg sm:leading-8">
        Report, search and help reunite pets with their families.
      </p>

      <!-- Actions -->
      <div class="mt-8 flex w-full flex-col gap-3 sm:flex-row">

        <a
          href="/report?status=lost"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#315c3e] px-6 py-4 text-sm font-semibold text-white shadow-sm transition hover:bg-[#264b32] sm:w-auto"
        >
          <PawPrint size={18} strokeWidth={2.2} />
          I Lost a Pet
        </a>

        <a
          href="/report?status=found"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-white px-6 py-4 text-sm font-semibold text-[#17372a] shadow-sm ring-1 ring-gray-200 transition hover:ring-[#315c3e] sm:w-auto"
        >
          <MapPin size={18} strokeWidth={2.2} />
          I Found a Pet
        </a>

      </div>

      <!-- Statistics -->
      <div class="mt-8 grid grid-cols-1 gap-4 sm:mt-10 sm:grid-cols-3 sm:gap-5 text-center">

        <div class="flex items-start justify-center gap-3 sm:justify-start">
          <UsersRound
            size={24}
            strokeWidth={1.8}
            class="mt-1 shrink-0 text-[#315c3e]"
          />

          <div>
            <p class="text-2xl font-bold text-[#17372a]">1,248</p>
            <p class="mt-1 text-sm text-gray-500">Pets reunited</p>
          </div>
        </div>

        <div class="flex items-start justify-center gap-3 sm:justify-start">
          <ClipboardList
            size={24}
            strokeWidth={1.8}
            class="mt-1 shrink-0 text-[#315c3e]"
          />

          <div>
            <p class="text-2xl font-bold text-[#17372a]">2,356</p>
            <p class="mt-1 text-sm text-gray-500">Reports posted</p>
          </div>
        </div>

        <div class="flex items-start justify-center gap-3 sm:justify-start">
          <Heart
            size={24}
            strokeWidth={1.8}
            class="mt-1 shrink-0 text-[#315c3e]"
          />

          <div>
            <p class="text-2xl font-bold text-[#17372a]">8,765</p>
            <p class="mt-1 text-sm text-gray-500">People helping</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>