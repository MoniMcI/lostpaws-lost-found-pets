---
import { PawPrint, MapPin } from 'lucide-astro';
---

<section class="bg-[#315c3e]">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-20">

    <div class="mx-auto max-w-3xl text-center">

      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-white/10">
        <PawPrint
          size={28}
          strokeWidth={1.8}
          class="text-white"
        />
      </div>

      <h2 class="mt-6 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Help a pet find its way home.
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">
        Whether you lost a pet or found one, your report can make a difference.
      </p>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">

        <a
          href="/report?status=lost"
          class="flex items-center justify-center gap-2 rounded-lg bg-white px-6 py-4 text-sm font-semibold text-[#315c3e] transition hover:bg-[#f1f7ec]"
        >
          <PawPrint size={18} strokeWidth={2} />
          I Lost a Pet
        </a>

        <a
          href="/report?status=found"
          class="flex items-center justify-center gap-2 rounded-lg border border-white/40 px-6 py-4 text-sm font-semibold text-white transition hover:bg-white/10"
        >
          <MapPin size={18} strokeWidth={2} />
          I Found a Pet
        </a>

      </div>

    </div>

  </div>
</section>