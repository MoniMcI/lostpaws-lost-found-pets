---
import { PawPrint, Facebook, Instagram, Mail } from 'lucide-astro';
---

<footer class="bg-[#252b29] text-white">

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">

    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">

      <!-- Brand -->
      <div class="lg:col-span-2">

        <a href="/" class="inline-flex items-center gap-2">
          <img
            src="/images/lostpaws-paw.png"
            alt=""
            class="h-9 w-9 object-contain brightness-0 invert"
          />

          <span class="text-2xl font-bold tracking-tight">
            LostPaws
          </span>
        </a>

        <p class="mt-4 max-w-md text-sm leading-6 text-white/70">
          Helping lost and found pets reconnect with the families who love them.
        </p>

        <div class="mt-6 flex items-center gap-4">

          <a
            href="#"
            aria-label="Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20"
          >
            <Facebook size={18} strokeWidth={1.8} />
          </a>

          <a
            href="#"
            aria-label="Instagram"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20"
          >
            <Instagram size={18} strokeWidth={1.8} />
          </a>

          <a
            href="#"
            aria-label="Email"
            class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20"
          >
            <Mail size={18} strokeWidth={1.8} />
          </a>

        </div>

      </div>

      <!-- Explore -->
      <div>
        <h3 class="text-sm font-semibold">
          Explore
        </h3>

        <ul class="mt-4 space-y-3 text-sm text-white/70">

          <li>
            <a href="/lost" class="transition hover:text-white">
              Lost Pets
            </a>
          </li>

          <li>
            <a href="/found" class="transition hover:text-white">
              Found Pets
            </a>
          </li>

          <li>
            <a href="/how-it-works" class="transition hover:text-white">
              How It Works
            </a>
          </li>

          <li>
            <a href="/faq" class="transition hover:text-white">
              FAQ
            </a>
          </li>

        </ul>
      </div>

      <!-- Get involved -->
      <div>
        <h3 class="text-sm font-semibold">
          Get involved
        </h3>

        <ul class="mt-4 space-y-3 text-sm text-white/70">

          <li>
            <a href="/report" class="transition hover:text-white">
              Report a Pet
            </a>
          </li>

          <li>
            <a href="/login" class="transition hover:text-white">
              Log In
            </a>
          </li>

          <li>
            <a href="/contact" class="transition hover:text-white">
              Contact us
            </a>
          </li>

        </ul>
      </div>

    </div>

    <!-- Bottom -->
    <div class="mt-10 border-t border-white/10 pt-6">

      <div class="flex flex-col gap-3 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">

        <p>
          © 2026 LostPaws. All rights reserved.
        </p>

        <div class="flex gap-5">

          <a
            href="/privacy"
            class="transition hover:text-white"
          >
            Privacy Policy
          </a>

          <a
            href="/terms"
            class="transition hover:text-white"
          >
            Terms of Use
          </a>

        </div>

      </div>

    </div>

  </div>

</footer>