---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'LostPaws — Find them. Bring them home.',
  description = 'A simple way to report, search and help reunite lost and found pets.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>